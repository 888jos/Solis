{
  "name": "solis",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "deploy": "npm test && node scripts/export-models.mjs && node scripts/keep-old-assets.mjs save && convex deploy -y --cmd 'npx vite build && node scripts/keep-old-assets.mjs restore' --cmd-url-env-var-name VITE_CONVEX_URL && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.98",
    "convex": "1.48.0",
    "convex-helpers": "0.1.129",
    "lucide-react": "^1.61.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
